#!/usr/bin/env bash

#set -e
#set -o xtrace
# manul test
# aws logs put-log-events --log-group-name "/example/basic/app2" --log-stream-name "1749113411" --log-events file://temp_log_event.json --output json
# Variables
LOG_GROUP_NAME="/example/basic/app2"
LOG_STREAM_NAME="1749266513"
LOG_FILE="web_server_logs.log"
SEQUENCE_TOKEN="None"

# Function to send log events
send_log_events() {
  local timestamp=$1
  local message=$2
  echo "$message" > /dev/tty
  
  # Create JSON file to avoid escaping issues
  cat > temp_log_event.json <<EOF
[{
  "timestamp": $timestamp,
  "message": "$message"
}]
EOF

  # Send logs with or without sequence token
  if [ "$SEQUENCE_TOKEN" == "None" ]; then
    response=$(aws logs put-log-events \
      --log-group-name "$LOG_GROUP_NAME" \
      --log-stream-name "$LOG_STREAM_NAME" \
      --log-events file://temp_log_event.json \
      --output json 2>&1)
    
    if echo "$response" | grep -q "error\|Error"; then
      echo "Error: $response" > /dev/tty
      return 1
    fi
    
    SEQUENCE_TOKEN=$(echo "$response" | jq -r '.nextSequenceToken // empty')
  else
    response=$(aws logs put-log-events \
      --log-group-name "$LOG_GROUP_NAME" \
      --log-stream-name "$LOG_STREAM_NAME" \
      --log-events file://temp_log_event.json \
      --sequence-token "$SEQUENCE_TOKEN" \
      --output json 2>&1)
    
    if echo "$response" | grep -q "error\|Error"; then
      echo "Error: $response" > /dev/tty
      return 1
    fi
    
    SEQUENCE_TOKEN=$(echo "$response" | jq -r '.nextSequenceToken // empty')
  fi
  
  # Clean up temp file
  rm -f temp_log_event.json
}

convert_to_iso() {
    local date_str="$1"
    
    # Extract parts: 30/May/2024:07:39:43 +0000
    local day=$(echo "$date_str" | cut -d'/' -f1)
    local month=$(echo "$date_str" | cut -d'/' -f2)
    local year_time=$(echo "$date_str" | cut -d'/' -f3)
    local year=$(echo "$year_time" | cut -d':' -f1)
    local time=$(echo "$year_time" | cut -d':' -f2- | sed 's/ +0000//')
    
    # Convert month to number
    case $month in
        Jan) month_num="01" ;;
        Feb) month_num="02" ;;
        Mar) month_num="03" ;;
        Apr) month_num="04" ;;
        May) month_num="05" ;;
        Jun) month_num="06" ;;
        Jul) month_num="07" ;;
        Aug) month_num="08" ;;
        Sep) month_num="09" ;;
        Oct) month_num="10" ;;
        Nov) month_num="11" ;;
        Dec) month_num="12" ;;
    esac
    
    # Format as ISO 8601
    echo "${year}-${month_num}-${day}T${time}+00:00"
}

# Read log file and send logs to CloudWatch
while IFS= read -r line; do
  # Extract datetime from log line (assumes format: IP - - [datetime] ...)
  original_datetime=$(echo "$line" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
  
  if [ -n "$original_datetime" ]; then
    iso_datetime=$(convert_to_iso "$original_datetime")
    # Convert to milliseconds timestamp
    timestamp=$(date --date="$iso_datetime" +%s000)
    
    # Escape quotes in message for JSON
    escaped_message=$(echo "$line" | sed 's/"/\\"/g')
    
    send_log_events "$timestamp" "$escaped_message"
    
    # Small delay to avoid rate limiting
    sleep 0.1
  else
    echo "Could not parse datetime from: $line" > /dev/tty
  fi
done < "$LOG_FILE"

echo "Logs have been sent to CloudWatch Log Stream $LOG_STREAM_NAME in Log Group $LOG_GROUP_NAME"